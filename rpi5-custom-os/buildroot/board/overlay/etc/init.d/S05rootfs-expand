#!/bin/sh
# First boot: grow / to fill the SD card (see /usr/sbin/rootfs-expand).
# Runs early (/ is already remounted rw by inittab), before syslog-heavy and
# network services start. Does nothing once /etc/rootfs-expanded exists.

case "$1" in
	start)
		[ -e /etc/rootfs-expanded ] && exit 0
		printf 'Expanding root filesystem: '
		if /usr/sbin/rootfs-expand >/var/log/rootfs-expand.log 2>&1; then
			echo "OK ($(df -h / | awk 'NR == 2 { print $2 }'))"
		else
			echo "FAIL (see /var/log/rootfs-expand.log)"
		fi
		;;
	stop|restart|reload) ;;
	*) echo "Usage: $0 {start}"; exit 1 ;;
esac
