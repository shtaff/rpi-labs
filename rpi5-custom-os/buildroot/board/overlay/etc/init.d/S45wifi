#!/bin/sh
# Wi-Fi on wlan0: load the driver, start wpa_supplicant, then DHCP.
# Runs after S40network (Ethernet) and before S50sshd.
#
# Networks live in /etc/wpa_supplicant.conf (generated from config.env).
# Change them on the Pi without rebuilding:
#   wpa_cli -i wlan0 add_network ; set_network 0 ssid '"Name"' ; set_network 0 psk '"pass"'
#   wpa_cli -i wlan0 enable_network 0 ; wpa_cli -i wlan0 save_config

IFACE=wlan0
CONF=/etc/wpa_supplicant.conf
WPA_PID=/var/run/wpa_supplicant.$IFACE.pid
DHCP_PID=/var/run/udhcpc.$IFACE.pid

start() {
	printf 'Starting Wi-Fi (%s): ' "$IFACE"
	# mdev normally loads it from the SDIO modalias; this is a fallback.
	modprobe -q brcmfmac 2>/dev/null
	# The chip and its firmware come up asynchronously: wait up to 15 s.
	i=0
	while [ ! -e "/sys/class/net/$IFACE" ] && [ "$i" -lt 15 ]; do
		sleep 1; i=$((i + 1))
	done
	if [ ! -e "/sys/class/net/$IFACE" ]; then
		echo "FAIL (no $IFACE; see: dmesg | grep brcmfmac)"
		return 1
	fi
	ip link set "$IFACE" up
	if ! wpa_supplicant -B -D nl80211 -i "$IFACE" -c "$CONF" -P "$WPA_PID"; then
		echo "FAIL (wpa_supplicant)"
		return 1
	fi
	# -b: background right away and keep retrying, since association can
	#     take a few seconds (or happen later, after a wpa_cli change).
	# -R: release the lease on stop.
	udhcpc -b -R -S -i "$IFACE" -p "$DHCP_PID" -x "hostname:$(hostname)" >/dev/null 2>&1
	echo "OK"
}

stop() {
	printf 'Stopping Wi-Fi (%s): ' "$IFACE"
	for pid in "$DHCP_PID" "$WPA_PID"; do
		[ -f "$pid" ] && kill "$(cat "$pid")" 2>/dev/null
		rm -f "$pid"
	done
	ip link set "$IFACE" down 2>/dev/null
	echo "OK"
}

case "$1" in
	start|stop) "$1" ;;
	restart|reload) stop; sleep 1; start ;;
	*) echo "Usage: $0 {start|stop|restart}"; exit 1 ;;
esac
