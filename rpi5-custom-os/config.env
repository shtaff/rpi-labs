# ---------------------------------------------------------------------------
#  Settings for the Yocto flow and the tools.
#  Edit these, or override any of them from the environment, e.g.
#      ROOT_PASSWORD=secret ./yocto/yocto.sh all
# ---------------------------------------------------------------------------

# Where everything is downloaded and built. MUST be on the Linux filesystem
# (e.g. under $HOME), never under /mnt/c — see README "Why not /mnt/c".
WORK_DIR="${WORK_DIR:-$HOME/rpi5-os}"

# Hostname the Pi will report (`hostname`, shell prompt).
RPI_HOSTNAME="${RPI_HOSTNAME:-mylab-rpi5}"

# Root password. Leave empty to be prompted at the `configure` step.
# It is stored only as a SHA-512 hash inside the build configuration.
ROOT_PASSWORD="${ROOT_PASSWORD:-}"

# Public key that will be baked into /home/root/.ssh/authorized_keys.
# Generated automatically if it doesn't exist yet.
SSH_PUBKEY="${SSH_PUBKEY:-$HOME/.ssh/id_ed25519.pub}"

# "no"  -> root may log in over SSH with the key only (recommended)
# "yes" -> root may also log in over SSH with the password
ALLOW_ROOT_PASSWORD_SSH="${ALLOW_ROOT_PASSWORD_SSH:-no}"

# ---- Wi-Fi (wlan0) --------------------------------------------------------
# Network the Pi joins on boot, in addition to Ethernet. Leave WIFI_SSID empty
# for Ethernet only: the Wi-Fi driver, firmware and wpa_supplicant are still
# installed, so you can add a network later on the Pi with wpa_cli.
# Put real values in config.local.env (git-ignored), not here.
WIFI_SSID="${WIFI_SSID:-}"

# WPA2 passphrase (8-63 characters). Leave empty to be prompted at the
# `configure` step; at the prompt, an empty answer means an open network.
# Only the derived 256-bit PSK is written into the image, never the passphrase.
WIFI_PSK="${WIFI_PSK:-}"

# Two-letter regulatory country (ISO 3166-1), e.g. DE, GB, UA, US. Without it
# the radio uses the restrictive "world" domain (many 5 GHz channels unusable).
WIFI_COUNTRY="${WIFI_COUNTRY:-UA}"

# Pinned versions (checked against upstream on 2026-10-10).
YOCTO_RELEASE="${YOCTO_RELEASE:-wrynose}"      # Yocto 6.0 (LTS)
BITBAKE_BRANCH="${BITBAKE_BRANCH:-2.18}"       # bitbake that matches wrynose

# Parallelism. Yocto on WSL is RAM-hungry: ~2 GB per thread is a safe rule.
JOBS="${JOBS:-$(nproc)}"

# Windows folder the finished image is copied to for flashing.
# Empty = auto-detect C:\Users\<you>\Downloads\rpi5-images
WIN_EXPORT_DIR="${WIN_EXPORT_DIR:-}"
